# Copy to .env — never commit a real .env
# ENVIRONMENT: development (default) or production. In production the app
# refuses to start if SECRET_KEY is still a shipped default (see config.py).
ENVIRONMENT=development
# SECRET_KEY: set a long random value in production. The defaults below are
# rejected at startup when ENVIRONMENT=production.
SECRET_KEY=change-me-to-a-long-random-secret
# CORS_ALLOWED_ORIGINS: extra comma-separated origins allowed to call the API
# (in addition to http://localhost:3000, http://127.0.0.1:3000 and FRONTEND_URL).
# Never "*".
CORS_ALLOWED_ORIGINS=
DATABASE_URL=sqlite:///./signspeak.db
# For Postgres: DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/signspeak
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_HOURS=24
# LiveKit (REQUIRED for real calls). Dev defaults below match a local
# `livekit-server --dev` (see backend/livekit-dev.md): ws://localhost:7880
# with the dev keys devkey / secret. For production, replace all three
# with real LiveKit Cloud (or self-hosted) credentials — never ship the
# dev keys. With these unset, GET /api/rooms/{id}/token returns 503.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LIVEKIT_WEBHOOK_SECRET: optional secret for verifying LiveKit webhook
# signatures; when empty, verification falls back to LIVEKIT_API_SECRET.
LIVEKIT_WEBHOOK_SECRET=
# Whisper ASR (REQUIRED for live captions; faster-whisper, local, no key)
# Download the model once: python -m app.services.speech_service --download
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=en
WHISPER_MODEL_DIR=backend/models/whisper-tiny
# Whisper speed on CPU: 0 = auto threads (container CPU quota, max 4);
# beam 1 = greedy decoding (much faster than beam 5 on CPU).
WHISPER_CPU_THREADS=0
WHISPER_BEAM_SIZE=1
# Live captions: cut utterances at this length if the speaker keeps
# talking; if captions fall more than CAPTION_MAX_LAG_S behind, the
# browser is told to switch to browser captions.
CAPTION_MAX_SEGMENT_S=8
CAPTION_MAX_LAG_S=12
CAPTION_MODEL_LOAD_TIMEOUT_S=45
# Sign recognition thresholds
SIGN_THRESHOLD_HIGH=0.85
SIGN_THRESHOLD_LOW=0.60
SIGN_SEQUENCE_LENGTH=30
SIGN_MODEL_PATH=app/ml/models/sign_lstm.pt
# Recorded landmark sequences for training (JSON, one file per sample).
SIGN_SAMPLES_DIR=backend/data/sign_samples
SIGN_SAMPLES_PER_LABEL_MAX=200
# TTS (Piper, local, no key). Download the voice once:
#   python -m app.services.tts_service --download
TTS_ENGINE=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_DIR=backend/models/piper
TTS_AUDIO_DIR=backend/data/tts
TTS_MAX_CHARS=500
# Voice agent (LiveKit "SignSpeak Voice" participant). Set false to disable.
VOICE_AGENT_ENABLED=true
