# ---- API ----
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://signspeak:signspeak@localhost:5432/signspeak
REDIS_URL=redis://localhost:6379/0

# Generate a real one for anything but a laptop:  openssl rand -hex 32
# The app refuses to boot in production with the default.
JWT_SECRET=dev-only-change-me

# ---- LiveKit ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret12345

# ---- Privacy ----
# Off by default. Transcripts are stored only when every participant consents,
# and rows expire after this many days.
STORE_TRANSCRIPTS_BY_DEFAULT=false
TRANSCRIPT_RETENTION_DAYS=30

# ---- ASR fallback (only used when Web Speech is unavailable) ----
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
