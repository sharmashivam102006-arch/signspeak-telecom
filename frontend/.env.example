# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Informational only: the real LiveKit URL comes from the backend
# GET /api/rooms/{id}/token response and is never hardcoded in the app.
# Local LiveKit server default:
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
